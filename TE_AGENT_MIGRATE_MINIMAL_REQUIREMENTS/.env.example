# Never commit real credentials or tokens.
TE_OAUTH_TOKEN=replace_with_api_v7_oauth_token
TE_AGENT_UI_USERNAME=admin
TE_AGENT_UI_PASSWORD=replace_with_agent_ui_password
TE_SOURCE_AID=replace_with_source_account_group_id
TE_TARGET_AID=replace_with_target_account_group_id
TE_TARGET_ACCOUNT_TOKEN=replace_with_32_character_registration_token
TE_TARGET_ACCOUNT_TOKEN_AID=replace_with_target_account_group_id
# One registration token per target account group (Strategy D, inventory v3).
# Replace <aid> with the target account group id, for example TE_TARGET_TOKEN_123456.
# If a variable is not set, the tool asks for the token with a hidden prompt (apply mode only).
# TE_TARGET_TOKEN_<aid>=
